# Optional. These variables are only read by the helper scripts and the API
# clients. Training and prediction run entirely on the committed CSV and .pkl
# files, so you do not need any key to run the tests or the web app.
#
# Copy this file to .env and fill in your own keys. .env is git-ignored.

# scripts/check_api.py -- football-data.org
# Free key: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_football_data_org_token
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# src/api/client.py -- API-Football (api-sports.io)
# Free key: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=your_api_sports_key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
